{
  "name": "codeharbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:db:up": "docker compose -f deploy/compose.test.yaml -p codeharbor-test up -d --wait",
    "test:db:down": "docker compose -f deploy/compose.test.yaml -p codeharbor-test down -v",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "install:web": "npm --prefix web ci",
    "check:web": "npm --prefix web run check",
    "test:web": "npm --prefix web test"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.2",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "tar-stream": "3.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/tar-stream": "3.1.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
